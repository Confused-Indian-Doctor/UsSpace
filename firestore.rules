rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(coupleId) {
      return signedIn() && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.auth.uid));
    }
    function safePayload() {
      return request.resource.data.payload is map
        && !request.resource.data.payload.keys().hasAny(['health', 'healthHistory', 'cycle']);
    }

    function safeProgress(p) {
      return p is map
        && p.keys().hasOnly(['v','known','xp','attempts','correct','streak','lastActive','cards','units','sessions','dailyGoal']);
    }
    function safeLearning(p) {
      return !('learn' in p) || (p.learn is map && p.learn.keys().hasOnly(['progress'])
        && (!('progress' in p.learn) || (p.learn.progress is map
          && p.learn.progress.keys().hasOnly(['al','yashika'])
          && (!('al' in p.learn.progress) || safeProgress(p.learn.progress.al))
          && (!('yashika' in p.learn.progress) || safeProgress(p.learn.progress.yashika)))));
    }
    function safeCommon() {
      return safePayload()
        && request.resource.data.payload.keys().hasOnly(['visit','duties','goals','notes','memories','learn'])
        && safeLearning(request.resource.data.payload);
    }
    function safeProfile() {
      return safePayload()
        && request.resource.data.payload.keys().hasOnly(['name','status','life','checkins','updated'])
        && (!('life' in request.resource.data.payload) || (request.resource.data.payload.life is map
          && request.resource.data.payload.life.keys().hasOnly(['watchTitle','watchType','watchDetail','exercise','exerciseDone','weekend','current','updated'])));
    }


    // New Us features use scalar-only schemas. Private feelings/contact details
    // never belong in these shared collections, including nested payload maps.
    function shortText(value, maximum) { return value is string && value.size() <= maximum; }
    function itemId(value) { return value is string && value.size() > 0 && value.size() <= 140 && value.matches('[A-Za-z0-9_-]+'); }
    function isoTime(value) { return shortText(value, 64) && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z'); }
    function optionalDate(value) { return value == '' || (shortText(value, 10) && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')); }
    function letterCategory(value) { return value in ['miss','sad','anxious','sleep','reassurance','proud','laugh','argument']; }
    function extrasRoles(coupleId) { return get(/databases/$(database)/documents/couples/$(coupleId)/usRoles/identity).data; }
    function hasExtrasRoles(coupleId) { return exists(/databases/$(database)/documents/couples/$(coupleId)/usRoles/identity); }
    function validBucket(d, id) {
      return d.keys().hasOnly(['id','title','category','location','targetDate','suggestedBy','suggestedName','priority','notes','photoId','state','completedDate','completedPhotoId','createdAt','updatedAt','updatedBy'])
        && d.id == id && itemId(id) && shortText(d.title, 160) && d.title.size() > 0
        && d.category in ['Travel','Food','Adventure','Date','Life','Learning','Silly','Future home']
        && shortText(d.location, 240) && optionalDate(d.targetDate)
        && shortText(d.suggestedBy, 160) && shortText(d.suggestedName, 160)
        && d.priority in ['Low','Normal','High'] && shortText(d.notes, 4000)
        && (d.photoId == '' || itemId(d.photoId)) && d.state in ['Dreaming','Planning','Booked','Done']
        && optionalDate(d.completedDate) && (d.completedPhotoId == '' || itemId(d.completedPhotoId))
        && isoTime(d.createdAt) && isoTime(d.updatedAt) && d.updatedBy == request.auth.uid;
    }
    function validJar(d, id) {
      return d.keys().hasOnly(['id','text','authorUid','authorName','createdAt'])
        && d.id == id && itemId(id) && shortText(d.text, 1500) && d.text.size() > 0
        && d.authorUid == request.auth.uid && shortText(d.authorName, 160) && isoTime(d.createdAt);
    }
    function validPhoto(d, id) {
      return d.keys().hasOnly(['id','ownerUid','data','createdAt'])
        && d.id == id && itemId(id) && d.ownerUid == request.auth.uid && isoTime(d.createdAt)
        && shortText(d.data, 140000) && d.data.matches('data:image/jpeg;base64,/9j/[A-Za-z0-9+/]*={0,2}');
    }
    function validDraft(d, id) {
      return d.keys().hasOnly(['id','coupleId','category','title','body','updatedAt'])
        && d.id == id && itemId(d.coupleId) && letterCategory(d.category)
        && id == d.coupleId + '_' + d.category
        && shortText(d.title, 200) && shortText(d.body, 12000) && isoTime(d.updatedAt);
    }
    function validLetter(d, category, coupleId) {
      return d.keys().hasOnly(['id','category','title','body','authorUid','recipientUid','publishedAt'])
        && letterCategory(category) && d.id == category && d.category == category
        && shortText(d.title, 200) && shortText(d.body, 12000) && d.body.size() > 0
        && isoTime(d.publishedAt) && hasExtrasRoles(coupleId)
        && d.authorUid == request.auth.uid && d.authorUid == extrasRoles(coupleId).alUid
        && d.recipientUid == extrasRoles(coupleId).yashikaUid;
    }

    // v0.14 settings/tokens are private to the signed-in account. Recipient
    // identity, pairs and generic notification contents are derived by Functions.
    function actorMatchesIfPresent() {
      return !('updatedBy' in request.resource.data) || request.resource.data.updatedBy == request.auth.uid;
    }
    function validClock(value) { return value is string && value.matches('([01][0-9]|2[0-3]):[0-5][0-9]'); }
    function validTimeZone(value) { return shortText(value, 80) && value.size() > 0 && value.matches('[A-Za-z0-9_+/-]+'); }
    function currentPair(coupleId) {
      return isMember(coupleId)
        && get(/databases/$(database)/documents/couples/$(coupleId)).data.memberCount == 2
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.coupleId == coupleId;
    }
    function validDevice(d, uid, id) {
      return d.keys().hasOnly(['uid','installationId','token','platform','enabled','updatedAt'])
        && d.uid == uid && d.installationId == id && id.matches('[A-Za-z0-9_-]{8,100}')
        && d.platform == 'android' && d.enabled is bool
        && shortText(d.token, 4096) && d.token.size() >= 20 && d.token.matches('[A-Za-z0-9_:.-]+')
        && d.updatedAt == request.time;
    }
    function validPreferences(d) {
      return d.keys().hasOnly(['theme','notifications','updatedAt'])
        && d.theme in ['system','light','dark'] && d.updatedAt == request.time
        && d.notifications is map && d.notifications.keys().hasOnly(['enabled','categories','quietHours'])
        && d.notifications.enabled is bool && d.notifications.categories is map
        && d.notifications.categories.keys().hasOnly(['pings','notes','status','goals','bucket','memories','calendar'])
        && d.notifications.categories.pings is bool && d.notifications.categories.notes is bool
        && d.notifications.categories.status is bool && d.notifications.categories.goals is bool
        && d.notifications.categories.bucket is bool && d.notifications.categories.memories is bool
        && d.notifications.categories.calendar is bool && d.notifications.quietHours is map
        && d.notifications.quietHours.keys().hasOnly(['enabled','start','end','timeZone'])
        && d.notifications.quietHours.enabled is bool && validClock(d.notifications.quietHours.start)
        && validClock(d.notifications.quietHours.end) && validTimeZone(d.notifications.quietHours.timeZone);
    }
    function validWorkSummary(d, coupleId, uid) {
      return d.keys().hasOnly(['uid','coupleId','date','start','end','timeZone','enabled','updatedAt'])
        && d.uid == uid && d.uid == request.auth.uid && d.coupleId == coupleId
        && optionalDate(d.date) && d.date != '' && validClock(d.start) && validClock(d.end)
        && validTimeZone(d.timeZone) && d.enabled == true && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;

      match /devices/{installationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && validDevice(request.resource.data, uid, installationId);
      }
      match /preferences/{preferenceId} {
        allow read, delete: if signedIn() && request.auth.uid == uid && preferenceId == 'v014';
        allow create, update: if signedIn() && request.auth.uid == uid && preferenceId == 'v014'
          && validPreferences(request.resource.data);
      }

      // Drafts survive disconnect but remain strictly within their author's
      // account; no partner query or accidental common-document projection.
      match /usLetterDrafts/{id} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid && validDraft(request.resource.data, id);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /usReceipts/{id} {
        // Missing-document reads are necessary for idempotent transactions.
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['operationId','coupleId','kind','itemId','at'])
          && itemId(request.resource.data.operationId) && itemId(request.resource.data.coupleId)
          && id == request.resource.data.coupleId + '_' + request.resource.data.operationId
          && request.resource.data.kind in ['roles','bucket','jar','heart','photo','draft','letter']
          && shortText(request.resource.data.itemId, 160) && request.resource.data.itemId.size() > 0
          && request.resource.data.at == request.time && isMember(request.resource.data.coupleId);
        allow update, delete: if false;
      }
    }

    match /_pushDeliveries/{id} { allow read, write: if false; }
    match /_pushWorkerCursors/{id} { allow read, write: if false; }
    match /_pushWorkerLeases/{id} { allow read, write: if false; }

    match /pairInvites/{code} {
      allow create: if signedIn()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.expiresAt > request.time
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.memberCount == 1
        && existsAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)/members/$(request.auth.uid));
      // A joining client may check a missing code and report "not found".
      // Existing invitations are readable only during their valid lifetime.
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/pairInvites/$(code))
          || resource.data.expiresAt > request.time);
      allow list: if false;
      allow update: if signedIn()
        && resource.data.used == false
        && resource.data.creatorUid != request.auth.uid
        && request.resource.data.used == true
        && request.resource.data.usedByUid == request.auth.uid
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.creatorUid == resource.data.creatorUid
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used','usedByUid','usedAt'])
        && getAfter(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.lastJoinUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.memberCount == 2;
      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberCount == 1;
      // A joining user learns a random coupleId only from a valid invite. Lists are never allowed.
      allow get: if isMember(coupleId) || (signedIn() && resource.data.memberCount == 1);
      allow list: if false;
      allow update: if (isMember(coupleId)
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.memberCount >= 0
          && !existsAfter(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.auth.uid))
          && request.resource.data.lastLeaveUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','lastLeaveUid','lastLeaveAt']))
        || (signedIn()
          && resource.data.memberCount == 1
          && request.resource.data.memberCount == 2
          && request.resource.data.lastJoinUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount','lastJoinCode','lastJoinUid'])
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.lastJoinCode)).data.used == true
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.lastJoinCode)).data.usedByUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.lastJoinCode)).data.coupleId == coupleId
          && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.lastJoinCode)).data.expiresAt > request.time);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(coupleId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && (
            (getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.ownerUid == uid
             && getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.memberCount == 1)
            ||
            (request.resource.data.inviteCode is string
             && getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.memberCount == 2
             && getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.lastJoinUid == uid
             && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.inviteCode)).data.usedByUid == uid)
          );
        allow update: if isMember(coupleId) && request.auth.uid == uid && request.resource.data.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid && isMember(coupleId);
      }


      match /usPings/{id} {
        allow read: if currentPair(coupleId);
        allow create: if currentPair(coupleId)
          && request.resource.data.keys().hasOnly(['id','senderUid','createdAt'])
          && request.resource.data.id == id && itemId(id)
          && request.resource.data.senderUid == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      // Optional partner summary contains only the owner's shift times. No
      // workbook URL, Graph token, room, simulation, patient or rota-row data.
      match /workSummaries/{uid} {
        allow read: if currentPair(coupleId);
        allow create, update: if currentPair(coupleId) && request.auth.uid == uid
          && validWorkSummary(request.resource.data, coupleId, uid);
        // An owner can revoke an old summary even after leaving that pair.
        allow delete: if signedIn() && request.auth.uid == uid && resource.data.uid == uid;
      }

      match /usRoles/{roleId} {
        allow read: if roleId == 'identity' && isMember(coupleId);
        allow create: if roleId == 'identity' && isMember(coupleId)
          && request.resource.data.keys().hasOnly(['alUid','yashikaUid'])
          && shortText(request.resource.data.alUid, 160) && shortText(request.resource.data.yashikaUid, 160)
          && request.resource.data.alUid != request.resource.data.yashikaUid
          && request.auth.uid in [request.resource.data.alUid, request.resource.data.yashikaUid]
          && get(/databases/$(database)/documents/couples/$(coupleId)).data.memberCount == 2
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.alUid))
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.yashikaUid));
        allow update, delete: if false;
      }
      match /usBucket/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && validBucket(request.resource.data, id)
          && request.resource.data.suggestedBy == request.auth.uid;
        allow update: if isMember(coupleId) && validBucket(request.resource.data, id)
          && request.resource.data.suggestedBy == resource.data.suggestedBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /usJar/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && validJar(request.resource.data, id);
        allow update: if isMember(coupleId) && validJar(request.resource.data, id)
          && resource.data.authorUid == request.auth.uid && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(coupleId) && resource.data.authorUid == request.auth.uid;
        match /hearts/{uid} {
          allow read: if isMember(coupleId);
          allow create, update: if isMember(coupleId) && request.auth.uid == uid
            && exists(/databases/$(database)/documents/couples/$(coupleId)/usJar/$(id))
            && request.resource.data.keys().hasOnly(['uid','active','at'])
            && request.resource.data.uid == uid && request.resource.data.active is bool && isoTime(request.resource.data.at);
          allow delete: if false;
        }
      }
      match /usPhotos/{id} {
        allow read: if isMember(coupleId);
        allow create: if isMember(coupleId) && validPhoto(request.resource.data, id);
        allow update: if isMember(coupleId) && validPhoto(request.resource.data, id)
          && resource.data.ownerUid == request.auth.uid && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /usLetters/{category} {
        // Al can read an absent target before an atomic publication transaction.
        allow get: if isMember(coupleId) && hasExtrasRoles(coupleId)
          && ((!exists(/databases/$(database)/documents/couples/$(coupleId)/usLetters/$(category))
              && request.auth.uid == extrasRoles(coupleId).alUid)
            || (resource.data.authorUid == extrasRoles(coupleId).alUid
              && resource.data.recipientUid == extrasRoles(coupleId).yashikaUid
              && request.auth.uid in [resource.data.authorUid, resource.data.recipientUid]));
        // Rules are not filters: clients must scope their author/recipient query.
        allow list: if isMember(coupleId) && hasExtrasRoles(coupleId)
          && ((request.auth.uid == extrasRoles(coupleId).alUid && resource.data.authorUid == request.auth.uid)
            || (request.auth.uid == extrasRoles(coupleId).yashikaUid && resource.data.recipientUid == request.auth.uid));
        allow create, update: if isMember(coupleId) && validLetter(request.resource.data, category, coupleId)
          && exists(/databases/$(database)/documents/couples/$(coupleId)/members/$(request.resource.data.recipientUid));
        allow delete: if false;
      }

      match /shared/{docId} {
        allow read: if isMember(coupleId);
        allow write: if docId == 'common' && isMember(coupleId) && safeCommon() && actorMatchesIfPresent();
      }

      match /profiles/{uid} {
        allow read: if isMember(coupleId);
        allow write: if isMember(coupleId) && request.auth.uid == uid && safeProfile() && actorMatchesIfPresent();
      }
    }
  }
}
