{
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true,
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "usspace-push",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        ".env*"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
