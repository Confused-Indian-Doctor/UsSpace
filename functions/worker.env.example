# This file has no credentials. Set the actual values only in protected host settings.
USSPACE_FIREBASE_PROJECT_ID=usspace-c859e
USSPACE_PUSH_WORKER_ENABLE=1
# Omit on a host with an attached IAM identity / Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/usspace-firebase.json
# Optional health probe. GET /healthz is readiness only, never a send endpoint.
PORT=8080
